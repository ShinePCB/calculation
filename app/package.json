{
  "name": "shinepcb-calculator-app",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor native wrapper for the ShinePCB PCB calculator",
  "license": "GPL-3.0-or-later",
  "homepage": "https://calculation.shinepcba.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShinePCB/calculation.git",
    "directory": "app"
  },
  "scripts": {
    "sync": "cap sync",
    "copy": "cap copy",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "build:android:debug": "npm run sync && cd android && gradlew.bat assembleDebug",
    "build:android:release": "npm run sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
